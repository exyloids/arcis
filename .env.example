ARCIS_ENV=development
ARCIS_LOG_LEVEL=INFO
ARCIS_DATABASE_URL=postgresql+psycopg://arcis:arcis@localhost:5432/arcis
ARCIS_REDIS_URL=redis://localhost:6379/0
ARCIS_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
ARCIS_OBJECT_STORAGE_BUCKET=arcis-local
ARCIS_OBJECT_STORAGE_ACCESS_KEY=arcis-local
ARCIS_OBJECT_STORAGE_SECRET_KEY=change-me
ARCIS_SESSION_COOKIE_SECURE=false
ARCIS_GMAIL_OAUTH_CLIENT_ID=
ARCIS_GMAIL_OAUTH_REDIRECT_URI=http://127.0.0.1:8765/callback
ARCIS_GMAIL_TEST_QUERY=
